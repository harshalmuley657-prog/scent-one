rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny all files
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Product Images Directory
    match /products/{imageId} {
      // Public visitors can view optimized perfume imagery
      allow read: if true;

      // Only verified administrators can upload or delete catalog imagery
      allow write, delete: if request.auth != null
        && (request.auth.token.admin == true || request.auth.token.role == 'owner')
        && request.resource.size < 5 * 1024 * 1024 // 5 MB ceiling
        && request.resource.contentType.matches('image/(jpeg|png|webp|svg\\+xml)');
    }

    // Brand Media & Assets Directory
    match /brand/{assetId} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.token.admin == true || request.auth.token.role == 'owner')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|svg\\+xml)');
    }
  }
}
